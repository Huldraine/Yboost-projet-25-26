STEAM_API_KEY=your_steam_api_key
PORT=8080
DB_PATH=steam_achievements.db

# Optional: enable Supabase/Postgres ORM CRUD routes
# Use either SUPABASE_DB_URL or DATABASE_URL.
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
